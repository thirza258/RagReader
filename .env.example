# ── Django ──────────────────────────────────────────
SECRET_KEY=change-me-to-a-random-secret-key
DEBUG=True
DEVELOPMENT_MODE=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost,rag.nevatal.tech
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5150,https://rag.nevatal.tech
CSRF_TRUSTED_ORIGINS=http://localhost:5150,https://rag.nevatal.tech
# Local (manual) setup — services on this machine:
DATABASE_URL=postgresql://myuser:changeme@localhost:5432/mydatabase
# Docker setup — use the compose service names instead (backend/.env):
# DATABASE_URL=postgresql://myuser:changeme@postgres:5432/mydatabase

# ── PostgreSQL (used by docker-compose) ──────────────
POSTGRES_DB=mydatabase
POSTGRES_USER=myuser
POSTGRES_PASSWORD=changeme

# ── Redis ───────────────────────────────────────────
# Local (manual) setup:
REDIS_URL=redis://localhost:6379/0
REDIS_HOST=localhost
REDIS_PORT=6379
# Docker setup — use the compose service names instead (backend/.env):
# REDIS_URL=redis://redis:6379/0
# REDIS_HOST=redis
# REDIS_PORT=6379

# ── LLM API Keys ────────────────────────────────────
# All LLM traffic goes through OpenRouter — only this key is required.
OPENROUTER_API_KEY=
# Optional: direct OpenAI key (for library compatibility)
OPENAI_API_KEY=

# ── RAG pipeline: per-run limits ────────────────────
# One variant is a full retrieve-generate-judge cycle, so the method × model
# matrix is capped. At 12 the shipped 3 methods × 3 models fits with room to
# spare; lowering it also narrows what the sidebar pre-selects.
# RAG_MAX_VARIANTS=12
# How many built pipelines to keep in memory. Raising it makes switching
# between many models faster and costs more RAM.
# RAG_ENGINE_CACHE_SIZE=12
# The model that scores faithfulness, answer relevance and answer coverage.
# Any OpenRouter id; also selectable per run from the deep-analysis sidebar.
# RAG_JUDGE_MODEL=mistralai/mistral-nemo
# The Ollama model that reranks hybrid's fused candidates. Served by the
# Ollama at OLLAMA_HOST (see backend/.env.example), not through OpenRouter,
# which is why the reranker list is closed. Whatever is set here is offered
# in the sidebar alongside the built-in choices.
#
# Every reranker the sidebar offers must be pulled on that Ollama host first:
#   ollama pull nomic-embed-text     # the default
#   ollama pull mxbai-embed-large    # only if you want to select it
#   ollama pull bge-m3               # only if you want to select it
# Picking one that isn't pulled doesn't fail the run — hybrid logs the error
# and falls back to the fused RRF order — but its results are then "fusion,
# no rerank", so don't read them as a reranked comparison.
# RAG_OLLAMA_EMBED_MODEL=nomic-embed-text

# ── RAG pipeline: ingest-time settings ──────────────
# These define the stored index, so they are NOT per-run: nothing on record
# ties an index to the embedding model that built it, and re-chunking deletes
# the ground truth attached to the old chunks. Changing one here affects
# documents indexed afterwards; re-upload to re-index an existing document.
# RAG_EMBEDDING_MODEL=openai/text-embedding-3-small
# RAG_CHUNK_STRATEGY=fixed          # fixed | paragraph | semantic
# RAG_CHUNK_SIZE=512
# RAG_CHUNK_OVERLAP=50
# RAG_VECTOR_STORE_PATH=./vector_stores
