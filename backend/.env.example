# ── Django ──────────────────────────────────────────
SECRET_KEY=change-me-to-a-random-secret-key
DEBUG=False
DEVELOPMENT_MODE=False
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost,rag.nevatal.tech
CORS_ALLOWED_ORIGINS=http://localhost:5150,https://rag.nevatal.tech
CSRF_TRUSTED_ORIGINS=http://localhost:5150,https://rag.nevatal.tech
DATABASE_URL=postgresql://myuser:changeme@postgres:5432/mydatabase

# ── PostgreSQL (used by docker-compose) ──────────────
POSTGRES_DB=mydatabase
POSTGRES_USER=myuser
POSTGRES_PASSWORD=changeme

# ── Redis ───────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
REDIS_HOST=redis
REDIS_PORT=6379

# ── Ollama ──────────────────────────────────────────
# Ollama serves on the host machine (not in a container); the Hybrid reranker
# reaches it via host.docker.internal, which docker-compose maps to the host.
# Set here or leave unset — compose sets this for backend/worker already.
# OLLAMA_HOST=http://host.docker.internal:11434

# ── LLM API Keys ────────────────────────────────────
# All LLM traffic goes through OpenRouter — only this key is required.
OPENROUTER_API_KEY=
# Optional: direct OpenAI key (for library compatibility)
OPENAI_API_KEY=
